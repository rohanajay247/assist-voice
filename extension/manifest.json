{
  "manifest_version": 3,
  "name": "Assist: Save my tabs",
  "version": "0.1.0",
  "description": "Lets your Assist voice assistant list, close and reopen your tabs.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Assist", "default_popup": "popup.html" }
}
